{
    "process": "intell_voice_service",
    "systemability": [
        {
            "name": 312,
            "libpath": "libintell_voice_server.z.so",
            "run-on-create": false,
            "auto-restart": true,
            "distributed": false,
            "dump_level": 1,
            "min_hdi_proxy_version": ["libintell_voice_engine_proxy_1.2.z.so"],
            "start-on-demand": {
                "commonevent": [
                    {
                        "name": "usual.event.BOOT_COMPLETED"
                    },
                    {
                        "name": "usual.event.POWER_SAVE_MODE_CHANGED",
                        "value": "600"
                    }
                ]
            }
        }
    ]
}